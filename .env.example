# --- Where the Audiobookshelf database lives (inside this container / on this machine)
ABS_DB_PATH=/abs-config/absdatabase.sqlite

# --- Audiobookshelf server URL, used for login and cover art
ABS_URL=http://audiobookshelf:80

# Optional: an ABS API key (Settings -> API Keys) so covers can be fetched.
# Without it, generated placeholder covers are used.
ABS_API_KEY=

# Timezone your listening should be bucketed in (match your ABS container's TZ)
TZ=America/New_York

# auth: "abs" (log in with Audiobookshelf accounts) or "demo" (no password, for the demo DB)
AUTH_MODE=abs

# --- Single sign-on (use the same OIDC provider as Audiobookshelf)
# The URL people open this app at; the redirect URI to register is PUBLIC_URL/api/auth/oidc/callback
PUBLIC_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_BUTTON_TEXT=Sign in with SSO
# Also match people by verified email when their provider ID isn't linked in ABS yet
OIDC_MATCH_EMAIL=true
# Show the ABS username/password form (set false if ABS only allows OIDC)
LOCAL_LOGIN=true

# Let every signed-in family member see the Family page (leaderboards, shared books)
FAMILY_VISIBLE=true

# How often to refresh the read-only snapshot of the ABS database
SNAPSHOT_MINUTES=10

# Where this app keeps its own files (snapshot, session secret)
DATA_DIR=./data
PORT=8787
